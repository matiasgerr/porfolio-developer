{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "portfolio-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm exec vite build && pnpm exec vite preview --port 4173 --strictPort"],
      "port": 4173
    }
  ]
}
